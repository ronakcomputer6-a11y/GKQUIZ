<!DOCTYPE html>
<html lang="gu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Question Bank</title>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 12px;
            line-height: 1.5;
        }

        .container {
            max-width: 600px; /* Responsive Mobile View */
            margin: 0 auto;
        }

        /* Top Bar - Mobile Friendly */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--card-bg);
            padding: 12px 16px;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            margin-bottom: 16px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }

        .title { 
            font-size: 18px; 
            margin: 0; 
            font-weight: bold;
            color: var(--primary);
        }

        .view-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12.5px;
            font-weight: bold;
            transition: transform 0.1s ease;
        }

        .view-btn:active {
            transform: scale(0.96);
        }

        /* Q&A Plain Simple Card */
        .qa-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 14px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 12px;
        }

        /* Question Layout */
        .question-text {
            font-size: 15.5px;
            font-weight: bold;
            margin: 0;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            color: var(--text-main);
            line-height: 1.4;
        }

        /* Gradient Round Circle for Question Number */
        .q-number-circle {
            background: linear-gradient(135deg, #4f46e5, #ec4899);
            color: #ffffff;
            min-width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: bold;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.3);
        }

        /* Simple Bookmark Icon Button */
        .bookmark-btn {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #94a3b8;
            transition: all 0.2s ease;
        }

        .bookmark-btn.active {
            border-color: #f59e0b;
            background: #fef3c7;
            color: #d97706;
        }

        /* Gradient Dotted Border Answer Card Wrapper */
        .answer-gradient-border-box {
            position: relative;
            padding: 3px; /* Border thickness */
            border-radius: 14px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed, #db2777);
            margin-top: 10px;
        }

        .answer-inner-content {
            background: #f8fafc;
            padding: 12px 14px;
            border-radius: 11px;
            border: 2px dotted #818cf8; /* Gradient Effect Dot Border */
        }

        .answer-tag {
            font-size: 12.5px;
            font-weight: bold;
            background: linear-gradient(135deg, #4f46e5, #db2777);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 4px;
            display: block;
        }

        .answer-text {
            font-size: 14px;
            line-height: 1.5;
            margin: 0;
            color: #334155;
        }

        .no-data {
            text-align: center;
            color: var(--text-muted);
            display: none;
            padding: 25px 15px;
            font-size: 14.5px;
            font-weight: 600;
            background: white;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>

    <div class="container">
        
        <div class="top-bar">
            <h1 class="title">પ્રશ્ન બેંક</h1>
            <button class="view-btn" id="toggleViewBtn" onclick="toggleView()">માત્ર બુકમાર્ક જુઓ</button>
        </div>

        <div id="noDataMessage" class="no-data">તમે હજુ સુધી કોઈ પ્રશ્ન બુકમાર્ક કર્યો નથી!</div>

        <div class="qa-container" id="qaContainer"></div>

    </div>

    <script>
        // ==========================================
        // પ્રશ્નો ઉમેરવા માટેનું લિસ્ટ:
        // ==========================================
        const questionsData = [
            {
                q: "RTE એડમિશન માટે કયા ડોક્યુમેન્ટ જોઈએ?",
                a: "બાળકના જન્મનો દાખલો, આધાર કાર્ડ, વાલીનું આધાર કાર્ડ, આવકનો દાખલો, રહેઠાણનો પુરાવો અને પાસપોર્ટ સાઇઝ ફોટો."
            },
            {
                q: "આધાર કાર્ડમાં નામ કેવી રીતે સુધારવું?",
                a: "તમારે નજીકના આધાર સેન્ટર પર જઈને માન્ય પુરાવો (જેમ કે પાન કાર્ડ અથવા ડ્રાઇવિંગ લાયસન્સ) ઓરિજિનલ જમા કરાવવો પડશે."
            },
            {
                q: "પોલીસ ભરતીની પરીક્ષા ક્યારે છે?",
                a: "ગુજરાત પોલીસ ભરતીની પરીક્ષાની તારીખ હજુ સત્તાવાર રીતે જાહેર થઈ નથી, નવીનતમ અપડેટ માટે OJAS વેબસાઈટ ચેક કરતા રહો."
            },
            {
                q: "પાન કાર્ડ અને આધાર કાર્ડ લિંક કેવી રીતે કરવું?",
                a: "ઇન્કમ ટેક્સની સત્તાવાર વેબસાઇટ (e-Filing portal) પર જઈને 'Link Aadhaar' વિકલ્પ પસંદ કરી ઓનલાઇન લિંક કરી શકાય છે."
            },
            {
                q: "આવકનો દાખલો ક્યાંથી નીકળશે?",
                a: "આવકનો દાખલો મામલતદાર કચેરી, તલાટી-કમ-મંત્રીની ઓફિસ અથવા 'Digital Gujarat' પોર્ટલ પરથી ઓનલાઇન નીકળી શકશે."
            }
        ];

        // ==========================================
        // પ્રોગ્રામિંગ કોડ
        // ==========================================
        const qaContainer = document.getElementById("qaContainer");
        let isShowingOnlyBookmarks = false;

        function loadQuestions() {
            let bookmarks = JSON.parse(localStorage.getItem("dottedBorderBookmarks")) || [];

            questionsData.forEach((item, index) => {
                let num = index + 1;
                let qId = "q" + num;
                let isBookmarked = bookmarks.includes(qId);
                let btnClass = isBookmarked ? "bookmark-btn active" : "bookmark-btn";
                let btnIcon = isBookmarked ? "⭐" : "☆";

                qaContainer.innerHTML += `
                    <div class="qa-card" id="${qId}">
                        <div class="card-header">
                            <div class="question-text">
                                <div class="q-number-circle">${num}</div>
                                <div style="margin-top: 2px;">${item.q}</div>
                            </div>
                            <button class="${btnClass}" onclick="toggleBookmark('${qId}')" id="btn-${qId}">${btnIcon}</button>
                        </div>
                        <div class="answer-gradient-border-box">
                            <div class="answer-inner-content">
                                <span class="answer-tag">જવાબ:</span>
                                <p class="answer-text">${item.a}</p>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function toggleBookmark(qId) {
            let bookmarks = JSON.parse(localStorage.getItem("dottedBorderBookmarks")) || [];
            let btn = document.getElementById(`btn-${qId}`);

            if (bookmarks.includes(qId)) {
                bookmarks = bookmarks.filter(id => id !== qId);
                btn.classList.remove("active");
                btn.innerHTML = "☆";
                
                if (isShowingOnlyBookmarks) {
                    document.getElementById(qId).style.display = "none";
                    checkEmptyState();
                }
            } else {
                bookmarks.push(qId);
                btn.classList.add("active");
                btn.innerHTML = "⭐";
            }
            localStorage.setItem("dottedBorderBookmarks", JSON.stringify(bookmarks));
        }

        function toggleView() {
            isShowingOnlyBookmarks = !isShowingOnlyBookmarks;
            let btn = document.getElementById("toggleViewBtn");
            let bookmarks = JSON.parse(localStorage.getItem("dottedBorderBookmarks")) || [];

            questionsData.forEach((item, index) => {
                let qId = "q" + (index + 1);
                let card = document.getElementById(qId);

                if (isShowingOnlyBookmarks) {
                    btn.innerHTML = "બધા પ્રશ્નો જુઓ";
                    if (bookmarks.includes(qId)) {
                        card.style.display = "block";
                    } else {
                        card.style.display = "none";
                    }
                } else {
                    btn.innerHTML = "માત્ર બુકમાર્ક જુઓ";
                    document.getElementById("noDataMessage").style.display = "none";
                    card.style.display = "block";
                }
            });
            
            if (isShowingOnlyBookmarks) checkEmptyState();
        }

        function checkEmptyState() {
            let bookmarks = JSON.parse(localStorage.getItem("dottedBorderBookmarks")) || [];
            if (bookmarks.length === 0) {
                document.getElementById("noDataMessage").style.display = "block";
            } else {
                document.getElementById("noDataMessage").style.display = "none";
            }
        }

        document.addEventListener("DOMContentLoaded", loadQuestions);
    </script>

</body>
</html>
